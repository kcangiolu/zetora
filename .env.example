# =============================================================================
# Zetora — Environment Configuration
#
# Copy this file to `.env.local` for local development (pnpm dev) or to
# `.env` for Docker Compose (NEXT_PUBLIC_* values are baked into the build —
# rebuild the image if they change).
#
# A first working instance needs:
#   - DATABASE_URL (pnpm dev) or POSTGRES_PASSWORD (Docker Compose)
#   - BETTER_AUTH_SECRET
#   - the public URL: NEXT_PUBLIC_APP_URL, BETTER_AUTH_BASE_URL, ALLOWED_ORIGINS
#   - one AI provider key and ZETORA_MODEL_DEFAULT
#   - SMTP_* to verify new accounts, or REQUIRE_EMAIL_VERIFICATION=false
#   - a search provider for web answers: SEARXNG_URL (`searxng` profile) or a
#     cloud key such as EXA_API_KEY
# Everything else is optional: unset, its feature is hidden or reports what
# is missing.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker — Persistent data directory
# -----------------------------------------------------------------------------
# Base path on the host for all persistent volumes. Each service gets its own
# subdirectory (postgres, redis, minio, ...). Create the directories before
# the first `docker compose up` — see the instructions in docker-compose.yml.
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Docker — Which bundled services run (see the table atop docker-compose.yml)
# -----------------------------------------------------------------------------
# Unset: minimal setup, Postgres + Redis + the app, cloud APIs for the rest.
# `selfhosted` adds every CPU-only service (Silo, SearXNG, fastCRW, sandbox,
# BullMQ, Qdrant, Presidio); `voice` (local speech-to-speech) and `tts` need an
# NVIDIA GPU; `hermes` is experimental. Each service also has its own profile.
# Point the matching variables below (S3_*, SEARXNG_URL, ...) at what you run.
# COMPOSE_PROFILES=selfhosted

# -----------------------------------------------------------------------------
# TTS service
# -----------------------------------------------------------------------------
# qwen3-tts is opt-in (compose profile "tts"): on a GPU shared with a local
# LLM, leaving it resident takes VRAM the LLM needs. `docker compose up -d`
# does not start it by default.
#   - Start it on demand:   docker compose --profile tts up -d qwen3-tts
#   - Stop it:               docker compose stop qwen3-tts
#   - Keep the container always running: add `tts` to COMPOSE_PROFILES above.

# Even when the container is running, the model itself lazy-loads on the
# first request and unloads from VRAM after 5min idle. Set to true to load
# it at container start instead and keep it always resident.
TTS_EAGER_LOAD=false
# TTS_EAGER_LOAD only affects *when* the model first loads — the 5min
# idle-unload above still applies regardless. Set this to keep the model
# resident forever once loaded (e.g. GPU fully dedicated to this service).
TTS_DISABLE_IDLE_UNLOAD=false

# Build args — only relevant if you build tts-service/Dockerfile yourself
# (docker-compose.yml has no `build:` section, it only ever pulls the CI
# image; docker-compose.build.yml reads these when building from source).
# CUDA base image. Use the -devel variant only for FLASH_ATTN_MODE=compile (nvcc).
TTS_CUDA_IMAGE=nvidia/cuda:13.1.2-runtime-ubuntu24.04
# PyTorch wheel suffix — must match the CUDA base image.
#   nvidia/cuda:13.1.x → cu130      nvidia/cuda:12.4.x → cu124
TTS_TORCH_CUDA_BUILD=cu130
# PyTorch version to install in the venv (must match the flash-attn wheel).
TTS_TORCH_VERSION=2.9.1
# flash-attn strategy:
#   prebuilt : precompiled wheel. Covers sm_80/86/89/90/100/120 — i.e. RTX 3090
#              (Ampere) through RTX 5060 Ti (Blackwell). The default; recommended.
#   compile  : build from source for TTS_FLASH_ATTN_ARCH_LIST — only for GPUs the
#              wheel misses. Requires TTS_CUDA_IMAGE=...-devel... (for nvcc).
#   none     : no flash-attn; server.py runs SDPA. Lightest image, slightly slower.
# In every mode server.py probes the GPU at startup and falls back to SDPA if the
# flash-attn kernel is unusable — the container never crashes on wrong hardware.
TTS_FLASH_ATTN_MODE=prebuilt
# Arches for FLASH_ATTN_MODE=compile (';'-separated). Ignored otherwise.
TTS_FLASH_ATTN_ARCH_LIST=8.0;8.6;8.9;9.0;10.0;12.0

# -----------------------------------------------------------------------------
# STT service
# -----------------------------------------------------------------------------
# stt-service starts with the `voice` profile. The model lazy-loads on the
# first request and unloads from VRAM after 5min idle. Set to true to load it at container
# start instead and keep it always resident.
STT_EAGER_LOAD=false
# STT_EAGER_LOAD only affects *when* the model first loads — the 5min
# idle-unload above still applies regardless. Set this to keep the model
# resident forever once loaded (e.g. GPU fully dedicated to this service).
STT_DISABLE_IDLE_UNLOAD=false

# -----------------------------------------------------------------------------
# Core (REQUIRED)
# -----------------------------------------------------------------------------
# Under docker compose, DATABASE_URL is built from POSTGRES_PASSWORD and the
# value here is ignored; set it for `pnpm dev` only.
DATABASE_URL=postgresql://user:password@host:5432/zetora
BETTER_AUTH_SECRET=
# Password of the bundled Postgres (docker compose refuses to start without it).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional read replicas (fallback to DATABASE_URL if unset)
READ_DB_1=
READ_DB_2=

# Comma-separated list of additional trusted origins for CORS/auth
ALLOWED_ORIGINS=https://your-domain.com

# Set to true only if every request reaches this app through a reverse proxy
# you control (nginx/Caddy/Traefik/Cloudflare) that overwrites or appends to
# X-Forwarded-For itself. When true, rate limiting (sign-in and exports)
# trusts the LAST hop of X-Forwarded-For, the entry your proxy added, not
# whatever the client sent. When false (default), no forwarding header is
# trusted and anonymous requests share a single bucket, because
# zetora.app's port is published on all interfaces (see docker-compose.yml)
# and a client that reaches it directly could otherwise spoof any of them.
# Default: false
TRUSTED_PROXY=false

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Public URL of this deployment. Used for OAuth callback URLs (e.g. MCP
# connections), as the Better Auth client/server base URL in production, and
# to build share links / OG metadata / email links instead of hardcoding a
# domain.
NEXT_PUBLIC_APP_URL=https://your-domain.com
BETTER_AUTH_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Show "Apps", where users connect their own MCP servers (sidebar link, /apps
# page, "mcp" search mode).
# Default: false (feature hidden)
NEXT_PUBLIC_MCP_ENABLED=false

# Origin of the sandboxed iframe used to render MCP UI resources (optional)
NEXT_PUBLIC_MCP_SANDBOX_ORIGIN=

# Show the "Canvas" search mode (interactive dashboards & visual reports).
# Default: false (feature hidden)
NEXT_PUBLIC_CANVAS_ENABLED=false

# -----------------------------------------------------------------------------
# Hermes Agent relay channel (hermes-relay-service, see its README.md)
# -----------------------------------------------------------------------------
# Master switch for the whole feature — the Settings > Hermes tab, the Agent
# mode entry everywhere it could appear, and every /api/hermes*
# /api/internal/hermes* route (404s when off). Experimental, so off here:
# set to true, and add `hermes` to COMPOSE_PROFILES above, to opt in. An
# unset value still means on, so an existing deployment that never set it
# keeps working. NEXT_PUBLIC_* values are baked in at build time (see
# docker-compose.build.yml) — changing this needs a rebuild, not just a
# container restart.
NEXT_PUBLIC_HERMES_ENABLED=false

# Encryption key for a connected gateway's per-gateway secret at rest — same
# posture as MCP_CREDENTIALS_ENCRYPTION_KEY below: must be a strong random
# value, not the "placeholder" default, before any Hermes gateway can enroll.
HERMES_GATEWAY_SECRET_ENCRYPTION_KEY=
# Shared secret gating the internal-only /api/internal/hermes/* routes, called
# by hermes-relay-service over the compose network — must match that service's
# own HERMES_RELAY_INTERNAL_SECRET (see docker-compose.yml).
HERMES_RELAY_INTERNAL_SECRET=
# Where zetora-app reaches hermes-relay-service's /control/deliver over the
# compose network (not the public URL below).
HERMES_RELAY_SERVICE_URL=http://hermes-relay-service:8200
# The public wss:// URL a user's own `hermes gateway enroll` dials — this must
# be reachable from THEIR machine, so it needs a real domain/reverse proxy in
# front of hermes-relay-service's port (8200), not just the compose network.
HERMES_RELAY_PUBLIC_URL=wss://your-domain.com:8200

# Web Push (RFC 8030) credentials for Hermes agent-reply notifications when no
# tab has the chat open. Generate a pair with `npx web-push generate-vapid-keys`.
# Both the server and public copy must be the SAME public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Allow new account creation (email/password and social). Set to false to
# close signups once an external gate (e.g. Authelia) is no longer in front
# of the app.
# Default: true
ALLOW_SIGNUPS=true

# New email/password accounts must confirm their address before signing in,
# which needs the SMTP settings below; without them sign-up is refused with an
# error naming what to set. Set to false on an instance with no SMTP server
# (a single user, a trusted network): accounts then sign in right away, and
# accounts already created unverified can sign in too.
# Default: true
REQUIRE_EMAIL_VERIFICATION=true

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
# The model list isn't hardcoded: it comes from models.dev (refreshed daily,
# see ai/catalog/), filtered to what the keys below can reach. A lab's own key
# serves its models directly; an aggregator key (AI Gateway, OpenRouter, Groq,
# Novita) serves every lab's models it hosts, and is tried as a fallback after
# the lab's own API. New models show up by themselves; retired ones disappear.
# Set at least one key.

# Labs' own APIs
OPENAI_API_KEY=
# Tried when OPENAI_API_KEY fails (rate limit, transient error) — a retry
# fallback, not a different model or load balancing.
OPENAI_API_KEY_2=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Gemini is reachable through two endpoints, each with its own picker tab —
# set either or both. Agent Platform (ex-Vertex AI) usage is billed to the
# Google Cloud billing account (free-trial credits apply); AI Studio usage
# needs AI Studio prepaid credits.
# Gemini via AI Studio (Gemini API)
GOOGLE_AI_STUDIO_API_KEY=
# Gemini via Agent Platform (API key bound to a service account)
GOOGLE_AGENT_PLATFORM_API_KEY=
# Google Cloud project ID or number the key belongs to (required with the key)
GOOGLE_AGENT_PLATFORM_PROJECT=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
# Z.ai (GLM)
ZAI_API_KEY=
MINIMAX_API_KEY=
SARVAM_API_KEY=

# Aggregators
# Vercel AI Gateway (on Vercel, its OIDC token works without this key)
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NOVITA_API_KEY=

# HF_TOKEN authenticates against the Hugging Face Inference Providers router —
# powers the small internal model the Auto router uses to classify queries.
HF_TOKEN=

# ─── Models ───────────────────────────────────────────────────────────────────
# The default model of each Zetora function, the same for every user. Each user
# can pick another one in Settings → AI Models, which shows these defaults.
# Values are model picker ids (`lab:model`), and the lab needs its API key or a
# host above (Gateway, OpenRouter...) that serves it.
# There is no fallback: a function with no model here and none picked in
# Settings does not work, and Settings says so in red.

# Chat and Lookout: the model new chats start on.
# Needs: a strong general model with tool calling; vision to read images.
# Examples: anthropic:claude-sonnet-5-5, openai:gpt-5.5, xai:grok-4.7, google:gemini-3.8-flash
ZETORA_MODEL_DEFAULT=

# Names new chats.
# Needs: a small, fast, cheap model.
# Examples: anthropic:claude-haiku-4-5, openai:gpt-5-nano, google:gemini-3.5-flash-lite
ZETORA_MODEL_CHAT_TITLE=

# Suggests follow-up questions after each answer.
# Needs: a small, fast model with reliable structured (JSON) output.
# Examples: openai:gpt-5-mini, google:gemini-3.5-flash-lite, anthropic:claude-haiku-4-5
ZETORA_MODEL_FOLLOWUP=

# Rewrites the prompt when the Enhance button is pressed.
# Needs: a fast model that writes well.
# Examples: anthropic:claude-haiku-5-5, openai:gpt-5.4-mini, google:gemini-3.5-flash
ZETORA_MODEL_ENHANCE=

# Fixes malformed tool call arguments.
# Needs: a small model with reliable structured (JSON) output.
# Examples: openai:gpt-5.4-mini, google:gemini-3.5-flash, anthropic:claude-haiku-4-5
ZETORA_MODEL_TOOL_REPAIR=

# Picks a route (model) for each message in Auto mode.
# Needs: a tiny, very fast classifier. zetora-arch-router is a 1.5B model built
# for this, served by Hugging Face (needs HF_TOKEN).
# Examples: zetora-arch-router, openai:gpt-5-nano, mistral:ministral-3b-2512
ZETORA_MODEL_AUTO_ROUTER=

# Translates text.
# Needs: a fast multilingual model.
# Examples: google:gemini-3.5-flash, alibaba:qwen3.8-flash, openai:gpt-5.4-mini
ZETORA_MODEL_TRANSLATE_TEXT=

# Reads and translates the text in images.
# Needs: vision.
# Examples: google:gemini-3.5-flash, openai:gpt-5.4-mini, anthropic:claude-haiku-5-5
ZETORA_MODEL_TRANSLATE_VISION=

# Detects the language of a text.
# Needs: a tiny, fast model.
# Examples: openai:gpt-5-nano, mistral:ministral-3b-2512, google:gemini-3.5-flash-lite
ZETORA_MODEL_LANG_DETECT=

# Plans the research of Extreme Search.
# Needs: a strong reasoning model with reliable structured (JSON) output.
# Examples: anthropic:claude-opus-5-5, openai:gpt-5.5, google:gemini-3.1-pro-preview
ZETORA_MODEL_EXTREME_PLANNER=

# Runs the Extreme Search research loop.
# Needs: a strong tool-calling model with a long context (200K+) that accepts
# forced tool calls; it always runs with thinking off.
# Examples: anthropic:claude-sonnet-5-5, openai:gpt-5.4, xai:grok-4.7
ZETORA_MODEL_EXTREME_AGENT=

# Answers in the local speech-to-speech voice mode.
# Needs: a low-latency model with tool calling.
# Examples: openai:gpt-5.4-mini, google:gemini-3.5-flash-lite, anthropic:claude-haiku-5-5
ZETORA_MODEL_VOICE=

# Summarizes older messages when a chat nears its context limit.
# Needs: a cheap model with a context at least as long as your chat models'.
# Examples: google:gemini-3.5-flash, deepseek:deepseek-flash, openai:gpt-5.4-mini
ZETORA_MODEL_CONTEXT_COMPACTION=

# Memory has no variable: the chat's own model updates it after each answer
# and tidies it up weekly, unless a Memory model is picked in Settings.

# Checks every image a user sends before the chat model sees it, and blocks the
# message when the model finds unsafe content (or cannot answer). An instance
# policy: unlike the models above, users cannot change it in Settings.
# Leave empty to turn image moderation off.
# Needs: vision; a small, fast model is enough.
# Examples: google:gemini-3.5-flash-lite, openai:gpt-5-nano, mistral:mistral-small-2603
ZETORA_MODEL_IMAGE_MODERATION=

# Custom AI Providers (JSON array) — user-defined OpenAI-compatible endpoints
# (e.g. self-hosted Ollama/llama.cpp), registered as custom-* models.
# Format: [{"id":"ollama","name":"Ollama (self-hosted)","baseURL":"http://localhost:11434/v1","apiKey":"ollama"}]
# These may point at the local network.
CUSTOM_AI_PROVIDERS=

# Providers users add in Settings can only reach public addresses, so a user
# cannot reach this host's network through them. Set to true to let them
# point at the local network too (a self-hosted llama.cpp or Ollama), for
# instances where every user is trusted.
# Default: false
CUSTOM_PROVIDERS_ALLOW_PRIVATE_NETWORK=false

# -----------------------------------------------------------------------------
# Authentication Providers (OAuth)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_TOKEN (optional but recommended): api.github.com repo metadata
# enrichment for github_search (exact stars/language/last-push). No scopes
# needed for public repos. Without it, enrichment falls back to 60 req/h
# unauthenticated and throttles under real usage.
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
# Sign-up verification, two-factor codes and Lookout results. Any SMTP server
# works, hosted ones included (Resend: smtp.resend.com, user "resend", your
# API key as password). Unset, sign-up is refused unless
# REQUIRE_EMAIL_VERIFICATION=false, and every email fails with an error naming
# what to set.
# Example: smtp.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender identity. Format: "Name <email@domain>", e.g. Zetora <noreply@example.com>
SMTP_FROM=
SMTP_SECURE=false

# Contact address shown on the privacy policy page for questions and data
# requests from this instance's users. Without it, the page says that no
# contact address is configured.
CONTACT_EMAIL=contact@example.com

# -----------------------------------------------------------------------------
# Cache / Queue
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Uploads and generated files, in any S3-compatible service. All of these
# are required except S3_PRESIGN_ENDPOINT; unset, uploads fail with an error
# naming what is missing.
#   Bundled Silo (--profile minio): S3_ENDPOINT=http://minio:9000, the
#     MINIO_ROOT_USER/MINIO_ROOT_PASSWORD keys below, S3_REGION=us-east-1,
#     S3_FORCE_PATH_STYLE=true.
#   Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
#     an R2 API token's keys, S3_REGION=auto.
#   AWS S3: S3_ENDPOINT=https://s3.<region>.amazonaws.com, S3_REGION=<region>.
# Admin credentials of the bundled Silo, only read with the minio profile.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Public URL of the Silo API (same base as S3_PRESIGN_ENDPOINT): presigned
# uploads are signed against it.
MINIO_SERVER_URL=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=zetora-uploads
S3_PUBLIC_URL=
# Host the browser uses to PUT uploads directly (presigned URLs are signed
# against this) — required if S3_ENDPOINT is an internal/Docker-only host
# (e.g. http://minio:9000). Same base as S3_PUBLIC_URL but WITHOUT the
# bucket name suffix. Leave unset when S3_ENDPOINT is already public.
S3_PRESIGN_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# Sandbox (code execution for the Code Interpreter tool)
# -----------------------------------------------------------------------------
# Where Python code runs: 'docker' (the bundled sandbox, --profile sandbox)
# or 'daytona' (Daytona's cloud). Unset, code execution fails with an error.
SANDBOX_PROVIDER=

# Required if SANDBOX_PROVIDER=daytona: the API key, and the snapshot code
# runs in. Create the snapshot once with scripts/create-daytona-snapshot.py,
# which prints the name to put here.
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=

# URL of the Docker sandbox service (required if SANDBOX_PROVIDER=docker;
# docker-compose.yml sets it to the bundled one)
DOCKER_SANDBOX_URL=

# Max code-interpreter executions allowed to hit the Docker sandbox at once;
# extra calls queue FIFO and time out after SANDBOX_QUEUE_TIMEOUT_MS instead of
# piling up unbounded `docker run` processes on the host. Docker provider only.
SANDBOX_MAX_CONCURRENT=3
SANDBOX_QUEUE_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Search & Web APIs
# -----------------------------------------------------------------------------
# Tool names below are what the LLM sees: web_search, academic_search,
# reddit_search, prediction_search, retrieve, extreme_search, stock_chart,
# github_search, currency_converter, code_context.
# finance/news search inside stock_chart only
TAVILY_API_KEY=
# EXA_API_KEY: default web_search provider (neural search); content-extraction
# fallback for retrieve/extreme_search's browsePage; also backs the
# code_context tool and Build Mode's browse/search tools.
EXA_API_KEY=
# FIRECRAWL_API_KEY: selectable web_search provider; scrape/content-fetch
# backend for academic_search, retrieve, extreme_search, github_search, and
# Build Mode.
FIRECRAWL_API_KEY=
# NOTTE_API_KEY: headless-browser scraper; JS-render fallback shared by
# retrieve, web_search, and extreme_search's content-extraction strategy,
# and by Build Mode's browsePage tool.
NOTTE_API_KEY=
# PARALLEL_API_KEY: sole backend for reddit_search; also a selectable
# web_search provider and content-fetch fallback for retrieve.
PARALLEL_API_KEY=
# prediction_search (Polymarket+Kalshi), finance data in stock_chart, and currency_converter (forex/crypto)
VALYU_API_KEY=

# Self-hosted services: each one is offered in Settings (and used by the
# tools) only when its URL is set. With the bundled containers (`selfhosted`
# profile) use the Docker service names shown in each comment; with `pnpm dev`,
# their localhost ports.
#
# SearXNG (metasearch engine). Bundled: http://searxng:8080
SEARXNG_URL=

# fastCRW (web scraper & search API, Firecrawl-compatible). Bundled: http://fastcrw:3000
FASTCRW_URL=

# web_search result caps — bump these for deployments that value a deeper,
# more thorough search over latency (defaults already favor thoroughness).
# ZETORA_SEARCH_GLOBAL_CAP=32
# ZETORA_SEARCH_PER_DOMAIN_CAP=3
# ZETORA_SEARCH_SNIPPET_MAX_CHARS=600

# Qdrant (vector database for Hybrid Search). Bundled: http://qdrant:6333
QDRANT_URL=
# The hybrid-search index collection is user-scoped (zetora_search_index_v2).
# Points from the old shared collection (zetora_search_index) are not
# migrated — the cache rebuilds automatically as searches run.
# Minimum cosine similarity for a Qdrant hit to be surfaced as a "[archive]"
# result (0-1). Lower this if relevant past results are being dropped.
# ZETORA_HYBRID_MIN_SCORE=0.55

# -----------------------------------------------------------------------------
# Media & Entertainment
# -----------------------------------------------------------------------------
# powers movie_or_tv_search, trending_movies, trending_tv
TMDB_API_KEY=
# TTS fallback when the self-hosted TTS server is unavailable
ELEVENLABS_API_KEY=
# OAuth client-credentials pair powering spotify_search
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SUPADATA_API_KEY: YouTube/TikTok/Twitter/Instagram transcripts & metadata —
# primary source for youtube_search and social content inside retrieve.
SUPADATA_API_KEY=

# -----------------------------------------------------------------------------
# Maps & Location
# -----------------------------------------------------------------------------
# Google Places API — powers find_place_on_map, nearby_places_search
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Weather & Aviation
# -----------------------------------------------------------------------------
# powers get_weather_data
OPENWEATHER_API_KEY=
# AMADEUS_API_KEY/SECRET: OAuth2 client-credentials pair powering
# track_flight (schedule/status by carrier+flight number, airline/airport
# reference lookups). Flights only, no hotel lookups.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# -----------------------------------------------------------------------------
# Crypto
# -----------------------------------------------------------------------------
# powers coin_data, coin_data_by_contract, coin_ohlc
COINGECKO_API_KEY=

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Required: encrypts custom-provider API keys saved in user
# preferences (fails closed instead of falling back to a known key if unset),
# and is the HMAC secret for the Anonymizer's PII pseudonymization tokens
# (see ANONYMIZER_API_URL below). Generate with: openssl rand -hex 32
MCP_CREDENTIALS_ENCRYPTION_KEY=
MCP_OAUTH_CALLBACK_ORIGIN=https://your-app-origin.com

# -----------------------------------------------------------------------------
# Lookouts Scheduling
# -----------------------------------------------------------------------------
# 'bullmq' (the bundled Redis queue, --profile bullmq) or 'qstash' (Upstash's
# cloud, for hosts with no long-running process such as Vercel). Unset,
# creating a Lookout fails with an error.
LOOKOUT_SCHEDULER=

# BullMQ
# Falls back to REDIS_URL if unset.
BULLMQ_REDIS_URL=
BULLMQ_REDIS_PASSWORD=

# QStash (required if LOOKOUT_SCHEDULER=qstash)
QSTASH_TOKEN=

# -----------------------------------------------------------------------------
# Cron & Security
# -----------------------------------------------------------------------------
# Shared secret protecting the /api/lookout scheduling callback. REQUIRED
# for lookouts (scheduled searches): without it the callback endpoint
# refuses every run.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Shared secret protecting /api/raycast (sent as an `Authorization: Bearer`
# header by the Raycast extension). REQUIRED for that endpoint: without it,
# every request is rejected with 401.
# Generate with: openssl rand -hex 32
RAYCAST_API_SECRET=

# -----------------------------------------------------------------------------
# Voice Assistant (cloud xAI backend and/or local s2s-service)
# -----------------------------------------------------------------------------
# URL of the external XAI voice backend (../xai-voice/xai/backend-nodejs).
# Default: http://localhost:8000
# NOTE: NEXT_PUBLIC_* is inlined into the client bundle at BUILD time — this
# is for the cloud backend only, unrelated to VOICE_S2S_URL below.
NEXT_PUBLIC_VOICE_BACKEND_URL=http://localhost:8000

# WebSocket URL of the local s2s-service backend (docker-compose's
# s2s-service), for the "Self-hosted" Voice option. Read server-side only (not
# NEXT_PUBLIC_*), so no rebuild needed when you change it — the app reads it
# fresh on each /api/voice/local-session request and hands it to the browser.
#
# Mini tutorial — why this needs more than just the docker-compose port:
#
# 1. Server-to-server calls (s2s-service -> /api/transcribe, /api/v1/chat/
#    completions, /api/tts/stream) already work over the docker-compose
#    network by container name (see s2s-service's APP_URL) — nothing to do
#    there.
# 2. But the realtime audio channel itself is a WebSocket the USER'S BROWSER
#    opens *directly* to s2s-service (to avoid an extra proxy hop's latency
#    on every audio frame). The browser is an external client — it has no
#    access to your docker network and can't resolve container names like
#    `http://s2s-service:8080`. It only reaches whatever's actually exposed
#    on the public internet/LAN, the same way it reaches this app itself.
# 3. So s2s-service needs the same kind of public entry point your app
#    already has. Two ways to get there:
#
#    a) Reverse-proxy path under your existing domain (recommended — reuses
#       your TLS cert, no new port to open). Add a location/route on
#       whatever reverse proxy already fronts NEXT_PUBLIC_APP_URL (nginx,
#       Caddy, Traefik, SWAG, ...) that proxies a sub-path to s2s-service's
#       published port, with WebSocket upgrade support and the URI rewritten
#       to /v1/realtime. Example nginx location block:
#
#         location /s2s/ {
#             proxy_http_version 1.1;
#             proxy_set_header Upgrade $http_upgrade;
#             proxy_set_header Connection "upgrade";
#             proxy_pass http://<host-running-s2s-service>:8100/v1/realtime$is_args$args;
#         }
#
#       (Skip proxy_http_version/Upgrade/Connection if your proxy config
#       already sets them globally, e.g. SWAG's included proxy.conf — nginx
#       errors on duplicate directives. Also note: when proxy_pass's target
#       uses variables instead of a literal address, nginx does NOT
#       automatically rewrite the URI or forward the query string — you
#       must spell out the target path and append $is_args$args yourself,
#       or the token query param silently gets dropped.)
#
#       Then: VOICE_S2S_URL=wss://your-domain.com/s2s/v1/realtime
#
#    b) Directly publish the port instead — bind s2s-service's docker-compose
#       port to 0.0.0.0 (not just 127.0.0.1) and open it on your firewall:
#       VOICE_S2S_URL=ws://your-domain-or-lan-ip:8100/v1/realtime
#       (plain ws://, not wss://, unless you add TLS separately — browsers
#       may block insecure ws:// from an https:// page)
#
# Left unset, the instance has no local voice backend and Settings only
# offers the cloud one. Local dev with `pnpm dev`: ws://localhost:8100/v1/realtime
VOICE_S2S_URL=

# -----------------------------------------------------------------------------
# Anonymizer (activatable PII masking layer — presidio-service)
# -----------------------------------------------------------------------------
# Left unset, the instance offers no anonymization (Settings hides it).
# Bundled: http://presidio-api:8000. Local dev: http://localhost:8004
ANONYMIZER_API_URL=

# -----------------------------------------------------------------------------
# s2s-service reachability check (Diagnostics panel only — NOT the same as
# VOICE_S2S_URL, which is the public browser-facing WS address)
# -----------------------------------------------------------------------------
S2S_SERVICE_URL=http://localhost:8100

# -----------------------------------------------------------------------------
# Search timeouts & wall-clock budgets (all optional, values are in milliseconds)
# -----------------------------------------------------------------------------
# Per-request fetch timeouts for self-hosted search/scrape services.
# ZETORA_FETCH_TIMEOUT_SEARXNG=15000
# ZETORA_FETCH_TIMEOUT_FASTCRW_SEARCH=20000
# ZETORA_FETCH_TIMEOUT_FASTCRW_SCRAPE=30000
# ZETORA_FETCH_TIMEOUT_METADATA=10000
# ZETORA_FETCH_TIMEOUT_NOTTE=150000

# Budget fastCRW gets per page when scraping a batch of search results: past
# it, the page is dropped instead of holding the whole answer.
# ZETORA_FASTCRW_SCRAPE_DEADLINE=8000

# Wall-clock budget for one extreme-search agent run (0 disables the deadline).
# ZETORA_EXTREME_WALL_CLOCK_MS=600000
# Wall-clock budget for the whole search request/stream (0 disables the timer).
# SEARCH_REQUEST_TIMEOUT_MS=1200000

# -----------------------------------------------------------------------------
# Development / debug helpers (all optional, leave unset in production)
# -----------------------------------------------------------------------------
# Public URL of a tunnel (e.g. ngrok) pointing at the local dev server; used to
# build the /api/lookout callback URL when scheduling lookouts from localhost.
NGROK_URL=
# Set to "true" to enable better-all's task-graph debug logging.
BETTER_ALL_DEBUG=
# Set to "1" to log /api/search setup timings (development only).
DEBUG_PERF=
# Debug and info logs are always on in development. In production, list the
# logger namespaces to enable (comma-separated, e.g. "search,memory"), or "*".
LOG_DEBUG=
