# =============================================================================
# Zetora — Environment Configuration
#
# Copy this file to `.env.local` for local development (pnpm dev) or to
# `.env` for a Docker build (the Dockerfile copies `.env` at build time, and
# NEXT_PUBLIC_* values are baked into the build — rebuild the image if they
# change).
#
# Only DATABASE_URL and BETTER_AUTH_SECRET are strictly required for the
# app to start. Everything else is optional and either has a working
# default or disables a specific feature when unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker — Persistent data directory
# -----------------------------------------------------------------------------
# Base path on the host for all persistent volumes. Each service gets its own
# subdirectory (postgres, redis, minio, ...). Create the directories before
# the first `docker compose up` — see the instructions in docker-compose.yml.
DATA_DIR=/mnt/user/appdata/zetora

# -----------------------------------------------------------------------------
# TTS service
# -----------------------------------------------------------------------------
# qwen3-tts is opt-in (compose profile "tts"): it shares the GPU with
# llama.cpp, so leaving it resident starves the LLM of VRAM and tanks decode
# speed. `docker compose up -d` will NOT start it by default.
#   - Start it on demand:   docker compose --profile tts up -d qwen3-tts
#   - Stop it:               docker compose stop qwen3-tts
#   - Keep it always resident (old behavior): uncomment the line below.
# COMPOSE_PROFILES=tts

# Build args — only relevant if you build tts-service/Dockerfile yourself
# (docker-compose.yml has no `build:` section, it only ever pulls the CI
# image; these aren't read unless you invoke `docker build` directly or add
# your own build override).
# CUDA base image. Use the -devel variant only for FLASH_ATTN_MODE=compile (nvcc).
TTS_CUDA_IMAGE=nvidia/cuda:13.1.2-runtime-ubuntu24.04
# PyTorch wheel suffix — must match the CUDA base image.
#   nvidia/cuda:13.1.x → cu130      nvidia/cuda:12.4.x → cu124
TTS_TORCH_CUDA_BUILD=cu130
# PyTorch version to install in the venv (must match the flash-attn wheel).
TTS_TORCH_VERSION=2.9.1
# flash-attn strategy:
#   prebuilt : precompiled wheel. Covers sm_80/86/89/90/100/120 — i.e. RTX 3090
#              (Ampere) through RTX 5060 Ti (Blackwell). The default; recommended.
#   compile  : build from source for TTS_FLASH_ATTN_ARCH_LIST — only for GPUs the
#              wheel misses. Requires TTS_CUDA_IMAGE=...-devel... (for nvcc).
#   none     : no flash-attn; server.py runs SDPA. Lightest image, slightly slower.
# In every mode server.py probes the GPU at startup and falls back to SDPA if the
# flash-attn kernel is unusable — the container never crashes on wrong hardware.
TTS_FLASH_ATTN_MODE=prebuilt
# Arches for FLASH_ATTN_MODE=compile (';'-separated). Ignored otherwise.
TTS_FLASH_ATTN_ARCH_LIST=8.0;8.6;8.9;9.0;10.0;12.0

# -----------------------------------------------------------------------------
# Core (REQUIRED)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/zetora
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Optional read replicas (fallback to DATABASE_URL if unset)
READ_DB_1=
READ_DB_2=

# Comma-separated list of additional trusted origins for CORS/auth
ALLOWED_ORIGINS=https://your-domain.com

# Set to true only if every request reaches this app through a reverse proxy
# you control (nginx/Caddy/Traefik/Cloudflare) that overwrites or appends to
# X-Forwarded-For itself. When true, rate limiting trusts the LAST hop of
# X-Forwarded-For (the entry your proxy added, not whatever the client sent)
# and X-Real-Ip/CF-Connecting-Ip. When false (default), none of those headers
# are trusted — anonymous requests share a single fallback bucket — because
# zetora.app's port is published on all interfaces (see docker-compose.yml)
# and a client that reaches it directly could otherwise spoof any of them.
# Default: false
TRUSTED_PROXY=false

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Public URL of this deployment. Used for OAuth callback URLs (e.g. MCP
# connections) and as the Better Auth client/server base URL in production.
NEXT_PUBLIC_APP_URL=https://your-domain.com
BETTER_AUTH_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Show the "Apps" / MCP marketplace (sidebar link, /apps page, "mcp" search mode).
# Default: false (feature hidden)
NEXT_PUBLIC_MCP_ENABLED=false

# Origin of the sandboxed iframe used to render MCP UI resources (optional)
NEXT_PUBLIC_MCP_SANDBOX_ORIGIN=

# Show the "Canvas" search mode (interactive dashboards & visual reports).
# Default: false (feature hidden)
NEXT_PUBLIC_CANVAS_ENABLED=false

# Allow new account creation (email/password and social). Set to false to
# close signups once an external gate (e.g. Authelia) is no longer in front
# of the app.
# Default: true
ALLOW_SIGNUPS=true

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
# Each key below only registers its provider's models (zetora-*) in the model
# picker if set to a real value — leave unset to hide that provider entirely.
XAI_API_KEY=your_xai_api_key_here                 # Grok (grok-3/4/4.1/4.5/4.20, grok-code)
OPENAI_API_KEY=your_openai_api_key_here           # GPT-5.x, 4.1, o3, o4-mini, codex models
ANTHROPIC_API_KEY=your_anthropic_api_key_here     # Claude (haiku/sonnet/opus 4.5-4.8, sonnet-5)
GROQ_API_KEY=your_groq_api_key_here               # Groq-hosted (llama-3.3-70b, kimi-k2, qwen3-32b, gpt-oss-20b)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here  # Gemini (flash/pro/3.x)

# Additional / secondary providers (optional)
# OPENAI_API_KEY_2 is a retry fallback used when OPENAI_API_KEY hits a
# rate limit or transient error — NOT a different model or load balancing.
OPENAI_API_KEY_2=your_secondary_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here         # Mistral/Ministral/Magistral/Devstral
COHERE_API_KEY=your_cohere_api_key_here           # Cohere Command-A
OPENROUTER_API_KEY=your_openrouter_api_key_here   # Arcee Trinity, StepFun free-tier models
ZAI_API_KEY=your_zai_api_key_here                 # Z.ai GLM-5/5.2 (OpenAI-compatible endpoint)
SARVAM_API_KEY=your_sarvam_api_key_here           # Sarvam AI sarvam-105b (OpenAI-compatible)
NOVITA_API_KEY=your_novita_api_key_here           # Novita AI: DeepSeek, Qwen3/3.5, GLM fallback
MINIMAX_API_KEY=your_minimax_api_key_here         # MiniMax M2.5/M2.7/M3
ARK_API_KEY=your_bytepluses_ark_api_key_here      # ByteDance/BytePlus Ark, Seed 1.6-2.0 models
BASETEN_API_KEY=your_baseten_api_key_here         # Baseten: gpt-oss-120b, DeepSeek-V3, Qwen3-Coder, Kimi-K2.5
# HF_TOKEN authenticates against the Hugging Face Inference Providers router
# (chat completion, not dataset access) — powers Qwen3/GLM-4.6 models and the
# internal zetora-arch-router model used to route requests between models.
HF_TOKEN=your_huggingface_token_here

# Self-hosted model endpoints (optional). These only flag the provider as
# "available" in the UI — the actual connection config comes from
# CUSTOM_AI_PROVIDERS below.
OLLAMA_URL=your_ollama_url_here
LLAMACPP_URL=your_llamacpp_url_here

# Custom AI Providers (JSON array) — user-defined OpenAI-compatible endpoints
# (e.g. self-hosted Ollama/llama.cpp), registered as custom-* models.
# Format: [{"id":"ollama","name":"Ollama (self-hosted)","baseURL":"http://localhost:11434/v1","apiKey":"ollama"}]
CUSTOM_AI_PROVIDERS=

# -----------------------------------------------------------------------------
# Authentication Providers (OAuth)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# -----------------------------------------------------------------------------
# Email Provider (Resend or SMTP)
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Zetora AI <noreply@example.com>

# SMTP (alternative to Resend)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Zetora AI <noreply@example.com>
SMTP_SECURE=false

# Contact address surfaced on legal pages (privacy policy, terms)
CONTACT_EMAIL=contact@example.com

# -----------------------------------------------------------------------------
# Cache / Queue
# -----------------------------------------------------------------------------
REDIS_URL=your_redis_url_here

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Only needed to delete/inspect legacy Vercel Blob uploads (pre-R2/S3
# migration) — read implicitly by the @vercel/blob SDK, not used for new uploads.
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Provider: 'cloudflare-r2' (default) or 'minio'
STORAGE_PROVIDER=cloudflare-r2

# Cloudflare R2 (used if STORAGE_PROVIDER=cloudflare-r2)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-r2-public-url.com

# MinIO / S3-compatible (used if STORAGE_PROVIDER=minio)
S3_ENDPOINT=your_s3_endpoint_here
S3_ACCESS_KEY_ID=your_s3_access_key_id_here
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
S3_BUCKET_NAME=zetora-uploads
S3_PUBLIC_URL=your_s3_public_url_here
# Host the browser uses to PUT uploads directly (presigned URLs are signed
# against this) — required if S3_ENDPOINT is an internal/Docker-only host
# (e.g. http://minio:9000). Same base as S3_PUBLIC_URL but WITHOUT the
# bucket name suffix. Defaults to S3_ENDPOINT when unset.
S3_PRESIGN_ENDPOINT=your_s3_presign_endpoint_here
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Sandbox (code execution for the Code Interpreter tool)
# -----------------------------------------------------------------------------
# Provider: 'daytona' (cloud) or 'docker' (self-hosted)
SANDBOX_PROVIDER=docker

# Required if SANDBOX_PROVIDER=daytona
DAYTONA_API_KEY=your_daytona_api_key_here

# URL of the self-hosted Docker sandbox service (required if SANDBOX_PROVIDER=docker)
DOCKER_SANDBOX_URL=your_docker_sandbox_url_here

# -----------------------------------------------------------------------------
# Payments & Subscriptions (Dodo Payments + Polar — both run concurrently, not
# primary/fallback; a user's Pro/Max access can come from either one, see
# `proSource` in lib/subscription.ts)
# -----------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here                # Dodo SDK bearer token
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_payments_webhook_secret_here  # verifies Dodo webhook signatures
POLAR_ACCESS_TOKEN=your_polar_access_token_here                      # Polar SDK client token
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here                  # verifies Polar webhook signatures

# Checkout product IDs / slugs. NOTE: despite the shared NEXT_PUBLIC_*_TIER
# naming, these are NOT symmetric per-provider tiers — Starter checks out
# through Polar; Premium ("Pro") and Max check out through Dodo Payments.
NEXT_PUBLIC_STARTER_TIER=your_starter_tier_product_id_here  # Polar: Starter plan product ID
NEXT_PUBLIC_STARTER_SLUG=your_starter_tier_slug_here        # Polar: Starter plan slug
NEXT_PUBLIC_PREMIUM_TIER=your_premium_tier_product_id_here  # Dodo: Pro plan product ID
NEXT_PUBLIC_PREMIUM_SLUG=your_premium_tier_slug_here        # Dodo: Pro plan slug
NEXT_PUBLIC_MAX_TIER=your_max_tier_product_id_here          # Dodo: Max plan product ID
NEXT_PUBLIC_MAX_SLUG=your_max_tier_slug_here                # Dodo: Max plan slug

# Override the Max tier product ID used for entitlement checks
# (defaults to NEXT_PUBLIC_MAX_TIER if unset)
DODO_MAX_PRODUCT_ID=

# Dodo Payments product ID for the student discount plan (leave unset to disable)
DODO_STUD_DISC_ID=

# -----------------------------------------------------------------------------
# Search & Web APIs
# -----------------------------------------------------------------------------
# Tool names below are what the LLM sees: web_search, academic_search,
# reddit_search, prediction_search, retrieve, extreme_search, stock_chart,
# github_search, currency_converter, code_context.
TAVILY_API_KEY=your_tavily_api_key_here           # finance/news search inside stock_chart only
# EXA_API_KEY: default web_search provider (neural search); content-extraction
# fallback for retrieve/extreme_search's browsePage; also backs the
# code_context tool and Build Mode's browse/search tools.
EXA_API_KEY=your_exa_api_key_here
# FIRECRAWL_API_KEY: selectable web_search provider; scrape/content-fetch
# backend for academic_search, retrieve, extreme_search, github_search, and
# Build Mode.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# NOTTE_API_KEY: headless-browser scraper; JS-render fallback shared by
# retrieve, web_search, and extreme_search's content-extraction strategy,
# and by Build Mode's browsePage tool.
NOTTE_API_KEY=your_notte_api_key_here
# PARALLEL_API_KEY: sole backend for reddit_search; also a selectable
# web_search provider and content-fetch fallback for retrieve.
PARALLEL_API_KEY=your_parallel_api_key_here
VALYU_API_KEY=your_valyu_api_key_here             # prediction_search (Polymarket+Kalshi), finance data in stock_chart, and currency_converter (forex/crypto)
# Cloudflare Workers AI (LLM inference, NOT search/scrape) — powers the
# zetora-ext-4 / zetora-nemotron-3-super models.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# SearXNG (self-hosted metasearch engine, used if configured as search provider)
SEARXNG_URL=your_searxng_url_here

# fastCRW (self-hosted web scraper & search API — Firecrawl alternative)
# Single Rust binary, ~50 MB RAM, Firecrawl-compatible (/v1/scrape, /v1/search)
FASTCRW_URL=your_fastcrw_url_here

# web_search result caps — bump these for deployments that value a deeper,
# more thorough search over latency (defaults already favor thoroughness).
# ZETORA_SEARCH_GLOBAL_CAP=32
# ZETORA_SEARCH_PER_DOMAIN_CAP=3
# ZETORA_SEARCH_SNIPPET_MAX_CHARS=600

# Qdrant (vector database for search cache & hybrid search)
QDRANT_URL=your_qdrant_url_here
# The hybrid-search index collection is user-scoped (zetora_search_index_v2).
# Points from the old shared collection (zetora_search_index) are not
# migrated — the cache rebuilds automatically as searches run.
# Minimum cosine similarity for a Qdrant hit to be surfaced as a "[archive]"
# result (0-1). Lower this if relevant past results are being dropped.
# ZETORA_HYBRID_MIN_SCORE=0.55

# -----------------------------------------------------------------------------
# Media & Entertainment
# -----------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_api_key_here               # powers movie_or_tv_search, trending_movies, trending_tv
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here   # TTS fallback when the self-hosted TTS server is unavailable
SPOTIFY_CLIENT_ID=your_spotify_client_id_here     # OAuth client-credentials pair powering spotify_search
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# SUPADATA_API_KEY: YouTube/TikTok/Twitter/Instagram transcripts & metadata —
# primary source for youtube_search and social content inside retrieve.
SUPADATA_API_KEY=your_supadata_api_key_here

# -----------------------------------------------------------------------------
# Maps & Location
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here # Google Places API — powers find_place_on_map, nearby_places_search

# -----------------------------------------------------------------------------
# Weather & Aviation
# -----------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here # powers get_weather_data
# AMADEUS_API_KEY/SECRET: OAuth2 client-credentials pair powering
# track_flight (schedule/status by carrier+flight number, airline/airport
# reference lookups). Flights only, no hotel lookups.
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# -----------------------------------------------------------------------------
# Crypto
# -----------------------------------------------------------------------------
COINGECKO_API_KEY=your_coingecko_api_key_here     # powers coin_data, coin_data_by_contract, coin_ohlc

# -----------------------------------------------------------------------------
# Memory & MCP
# -----------------------------------------------------------------------------
# SUPERMEMORY_API_KEY: hosted third-party memory SaaS powering the
# search_memories/add_memory tools — distinct from the self-hosted Graphiti
# knowledge graph configured further below.
SUPERMEMORY_API_KEY=your_supermemory_api_key_here
# Required: encrypts custom-provider and Graphiti API keys saved in user
# preferences (fails closed instead of falling back to a known key if unset),
# and is the HMAC secret for the Anonymizer's PII pseudonymization tokens
# (see ANONYMIZER_API_URL below). Generate with: openssl rand -hex 32
MCP_CREDENTIALS_ENCRYPTION_KEY=your_mcp_credentials_encryption_key_here
MCP_OAUTH_CALLBACK_ORIGIN=https://your-app-origin.com

# Zetora-managed OAuth apps for one-click MCP connections (leave unset to disable)
GITHUB_MCP_CLIENT_ID=your_github_mcp_client_id_here
GITHUB_MCP_CLIENT_SECRET=your_github_mcp_client_secret_here
SLACK_MCP_CLIENT_ID=your_slack_mcp_client_id_here
SLACK_MCP_CLIENT_SECRET=your_slack_mcp_client_secret_here
BOX_MCP_CLIENT_ID=your_box_mcp_client_id_here
BOX_MCP_CLIENT_SECRET=your_box_mcp_client_secret_here
DROPBOX_MCP_CLIENT_ID=your_dropbox_mcp_client_id_here
DROPBOX_MCP_CLIENT_SECRET=your_dropbox_mcp_client_secret_here
HUBSPOT_MCP_CLIENT_ID=your_hubspot_mcp_client_id_here
HUBSPOT_MCP_CLIENT_SECRET=your_hubspot_mcp_client_secret_here

# -----------------------------------------------------------------------------
# Lookouts Scheduling (BullMQ or QStash)
# -----------------------------------------------------------------------------
# BullMQ (self-hosted Redis-based queue)
BULLMQ_ENABLED=false
# Falls back to REDIS_URL if unset.
BULLMQ_REDIS_URL=your_bullmq_redis_url_here
BULLMQ_REDIS_PASSWORD=

# QStash (managed alternative to BullMQ)
QSTASH_TOKEN=your_qstash_token_here

# -----------------------------------------------------------------------------
# Cron & Security
# -----------------------------------------------------------------------------
# Shared secret protecting the /api/clean_images cron endpoint and the
# /api/lookout scheduling callback. REQUIRED for lookouts (scheduled
# searches): without it the callback endpoint refuses every run.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Shared secret protecting /api/raycast (sent as an `Authorization: Bearer`
# header by the Raycast extension). REQUIRED for that endpoint: without it,
# every request is rejected with 401.
# Generate with: openssl rand -hex 32
RAYCAST_API_SECRET=your_raycast_api_secret_here

# -----------------------------------------------------------------------------
# Voice Assistant (cloud xAI backend and/or local s2s-service)
# -----------------------------------------------------------------------------
# URL of the external XAI voice backend (../xai-voice/xai/backend-nodejs).
# Default: http://localhost:8000
# NOTE: NEXT_PUBLIC_* is inlined into the client bundle at BUILD time — this
# is for the cloud backend only, unrelated to VOICE_S2S_URL below.
NEXT_PUBLIC_VOICE_BACKEND_URL=your_voice_backend_url_here

# WebSocket URL of the local s2s-service backend (docker-compose's
# s2s-service), for the "Self-hosted" Voice option. Read server-side only (not
# NEXT_PUBLIC_*), so no rebuild needed when you change it — the app reads it
# fresh on each /api/voice/local-session request and hands it to the browser.
#
# Mini tutorial — why this needs more than just the docker-compose port:
#
# 1. Server-to-server calls (s2s-service -> /api/transcribe, /api/v1/chat/
#    completions, /api/tts/stream) already work over the docker-compose
#    network by container name (see s2s-service's APP_URL) — nothing to do
#    there.
# 2. But the realtime audio channel itself is a WebSocket the USER'S BROWSER
#    opens *directly* to s2s-service (to avoid an extra proxy hop's latency
#    on every audio frame). The browser is an external client — it has no
#    access to your docker network and can't resolve container names like
#    `http://s2s-service:8080`. It only reaches whatever's actually exposed
#    on the public internet/LAN, the same way it reaches this app itself.
# 3. So s2s-service needs the same kind of public entry point your app
#    already has. Two ways to get there:
#
#    a) Reverse-proxy path under your existing domain (recommended — reuses
#       your TLS cert, no new port to open). Add a location/route on
#       whatever reverse proxy already fronts NEXT_PUBLIC_APP_URL (nginx,
#       Caddy, Traefik, SWAG, ...) that proxies a sub-path to s2s-service's
#       published port, with WebSocket upgrade support and the URI rewritten
#       to /v1/realtime. Example nginx location block:
#
#         location /s2s/ {
#             proxy_http_version 1.1;
#             proxy_set_header Upgrade $http_upgrade;
#             proxy_set_header Connection "upgrade";
#             proxy_pass http://<host-running-s2s-service>:8100/v1/realtime$is_args$args;
#         }
#
#       (Skip proxy_http_version/Upgrade/Connection if your proxy config
#       already sets them globally, e.g. SWAG's included proxy.conf — nginx
#       errors on duplicate directives. Also note: when proxy_pass's target
#       uses variables instead of a literal address, nginx does NOT
#       automatically rewrite the URI or forward the query string — you
#       must spell out the target path and append $is_args$args yourself,
#       or the token query param silently gets dropped.)
#
#       Then: VOICE_S2S_URL=wss://your-domain.com/s2s/v1/realtime
#
#    b) Directly publish the port instead — bind s2s-service's docker-compose
#       port to 0.0.0.0 (not just 127.0.0.1) and open it on your firewall:
#       VOICE_S2S_URL=ws://your-domain-or-lan-ip:8100/v1/realtime
#       (plain ws://, not wss://, unless you add TLS separately — browsers
#       may block insecure ws:// from an https:// page)
#
# Left unset, local voice falls back to ws://localhost:8100/v1/realtime,
# which only works if the browser and the s2s-service container are on the
# same machine (e.g. local dev with `pnpm dev`).
VOICE_S2S_URL=wss://your-domain.com/s2s/v1/realtime

# -----------------------------------------------------------------------------
# Graphiti (Knowledge Graph Memory)
# -----------------------------------------------------------------------------
GRAPHITI_API_URL=your_graphiti_api_url_here
GRAPHITI_LLM_MODEL=gpt-4o-mini
GRAPHITI_EMBEDDING_MODEL=text-embedding-3-small

# Leave empty to use the defaults configured in the graphiti-api service
GRAPHITI_LLM_API_KEY=
GRAPHITI_LLM_BASE_URL=
GRAPHITI_EMBEDDING_API_KEY=
GRAPHITI_EMBEDDING_BASE_URL=

# -----------------------------------------------------------------------------
# Anonymizer (activatable PII masking layer — presidio-service)
# -----------------------------------------------------------------------------
ANONYMIZER_API_URL=http://localhost:8004

# -----------------------------------------------------------------------------
# s2s-service reachability check (Diagnostics panel only — NOT the same as
# VOICE_S2S_URL, which is the public browser-facing WS address)
# -----------------------------------------------------------------------------
S2S_SERVICE_URL=http://localhost:8100

# -----------------------------------------------------------------------------
# Search timeouts & wall-clock budgets (all optional, values are in milliseconds)
# -----------------------------------------------------------------------------
# Per-request fetch timeouts for self-hosted search/scrape/memory services.
# ZETORA_FETCH_TIMEOUT_SEARXNG=15000
# ZETORA_FETCH_TIMEOUT_FASTCRW_SEARCH=20000
# ZETORA_FETCH_TIMEOUT_FASTCRW_SCRAPE=30000
# ZETORA_FETCH_TIMEOUT_METADATA=10000
# ZETORA_FETCH_TIMEOUT_NOTTE=150000
# ZETORA_FETCH_TIMEOUT_GRAPHITI=30000
# Episode ingestion runs LLM entity extraction server-side; give it more room.
# ZETORA_FETCH_TIMEOUT_GRAPHITI_INGEST=180000

# Wall-clock budget for one extreme-search agent run (0 disables the deadline).
# ZETORA_EXTREME_WALL_CLOCK_MS=600000
# Wall-clock budget for the whole search request/stream (0 disables the timer).
# SEARCH_REQUEST_TIMEOUT_MS=1200000

# -----------------------------------------------------------------------------
# Development / debug helpers (all optional, leave unset in production)
# -----------------------------------------------------------------------------
# Public URL of a tunnel (e.g. ngrok) pointing at the local dev server; used to
# build the /api/lookout callback URL when scheduling lookouts from localhost.
NGROK_URL=
# Set to "true" to enable better-all's task-graph debug logging.
BETTER_ALL_DEBUG=
# Set to "1" to log /api/search setup timings (development only).
DEBUG_PERF=
